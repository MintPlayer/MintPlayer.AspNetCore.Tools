<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- [ValidatableType] is [Experimental("ASP0029")] on net10.0, reported as an error (PRD R5.6). -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);ASP0029</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints\MintPlayer.AspNetCore.Endpoints.csproj" />
		<!-- Generic library endpoints this app closes with [assembly: EndpointTypeArgument<LibUser, AppUser>] (issue #34). -->
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.TestLibrary\MintPlayer.AspNetCore.Endpoints.TestLibrary.csproj" />
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- AddOpenApi()/MapOpenApi() are not in the shared framework. Referencing the package here is
		     also what makes the generator emit EndpointOpenApi.g.cs for this app; the runtime library
		     deliberately takes no such reference (PRD R4.7).

		     Its version tracks the framework: keep it on 10.0.x on this line. -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
	</ItemGroup>

	<!--
	The contract snapshot (PRD R7.5). Every build runs this app's Program.cs under GetDocument.Insider
	and writes the OpenAPI document it serves to openapi/MintPlayer.AspNetCore.Endpoints.TestApp.json,
	which is committed. CI fails when a build leaves that file changed (an endpoint was changed without
	committing the new contract) and runs `oasdiff breaking` against the base branch's copy.

	The package version tracks Microsoft.AspNetCore.OpenApi above, for the same reason.
	-->
	<PropertyGroup>
		<OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
		<OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
		<OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
