<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<!--
		A regression gate for the library's own code, not an AOT claim (PRD R6.4, R7.6): the reflective
		manual MapEndpoint<T>() path is annotated [RequiresUnreferencedCode]/[RequiresDynamicCode], and
		the generated mapping still binds through the Delegate overload of MapMethods in the consumer.
		-->
		<IsAotCompatible>true</IsAotCompatible>

		<IsPackable>true</IsPackable>
		<PackageId>MintPlayer.AspNetCore.Endpoints</PackageId>
		<Version>11.1.0-rc.0</Version>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Description>Class-per-endpoint mapping library for ASP.NET Core with constructor injection, content negotiation, and source-generated endpoint discovery.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageTags>ASP.NET Core, Endpoints, Minimal API</PackageTags>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.AspNetCore.Tools/Endpoints/MintPlayer.AspNetCore.Endpoints</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.AspNetCore.Tools</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Product>MintPlayer.AspNetCore.Endpoints</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!--
	On net10.0 Microsoft.Extensions.Validation is [Experimental("ASP0029")], and the compiler reports
	that as an ERROR on the whole API RequestValidation.cs calls (ValidationOptions.Resolvers,
	TryGetValidatableTypeInfo, IValidatableInfo, ValidateContext) — there is no Web-SDK exemption
	(PRD R5.6). On net11.0 the API has graduated, so the suppression is scoped to net10.0 only: an
	unconditioned NoWarn would also hide a genuinely new experimental API on the newer framework.
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<NoWarn>$(NoWarn);ASP0029</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!-- Makes GenerateEndpointsClient visible to the typed-client generator this package carries (M9). -->
		<None Include="build\MintPlayer.AspNetCore.Endpoints.props" Pack="true" PackagePath="build\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.Abstractions\MintPlayer.AspNetCore.Endpoints.Abstractions.csproj" />
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj"
		                  ReferenceOutputAssembly="false"
		                  PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.SourceGenerators.Tools" Version="10.16.0" PrivateAssets="all" GeneratePathProperty="true" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Include XML markups in the nupkg -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!--
	Pack the source generator and its dependencies into the analyzers folder.

	The generator project is asked where its outputs are (GetTargetPath) instead of having its
	output layout spelled out here. A literal ..\Generator\bin\$(Configuration)\netstandard2.0\
	path is a second, silently divergent copy of that layout, and it goes stale the moment either
	project changes its TargetFramework or output path — producing a nupkg with no analyzer in it
	and no error. GetTargetPath also returns what the generator's own GetDependencyTargetPaths
	target adds, so MintPlayer.SourceGenerators.Tools comes along in every configuration rather
	than only in Release.
	-->
	<PropertyGroup>
		<!--
		The analyzer is not TFM-specific, but the only mechanism that reliably packs it is a
		TFM-specific one, and that runs once per inner build. Emitting from every inner build adds the
		same file to the same package path N times: NuGet de-duplicates and the package is still
		correct, but it warns (NU5118) once per extra TFM, which breaks the warning-clean build.

		So: emit from the first inner build only. The first TFM is derived from TargetFrameworks
		rather than written out, because a hardcoded 'net10.0' here becomes a silent defect the day
		that TFM is dropped or reordered — the condition would simply never match and the package
		would ship with no analyzer and no error, which is the same class of failure the comment
		below describes.

		Do not be tempted to hoist this onto BeforeTargets="GenerateNuspec" with <None Pack="true">
		so it runs once for the outer build. That was measured: it packs with zero warnings and
		produces a nupkg containing no analyzer at all.
		-->
		<_AnalyzerPackTfm>$(TargetFrameworks.Split(';')[0])</_AnalyzerPackTfm>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackEndpointsGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="PackEndpointsGenerator" Condition="'$(TargetFramework)' == '$(_AnalyzerPackTfm)'">
		<MSBuild Projects="..\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj"
		         Targets="GetTargetPath"
		         Properties="Configuration=$(Configuration)"
		         RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" ItemName="_EndpointsGeneratorAnalyzer" />
		</MSBuild>

		<!--
		  Guards, not warnings. An analyzer payload that comes out empty installs perfectly happily
		  and then does nothing: no generated mapping, no diagnostic, and nothing for the consumer
		  to search for. There is no error to notice, so the only way this is caught is by failing
		  the pack.

		  Two different existence tests are needed and mixing them up produces a guard that can
		  never fire. GetTargetPath returns a literal path, so the item exists whether or not the
		  file does, which calls for Exists('%(...)'). A glob contributes no items at all when it
		  matches nothing, so it would have to be tested as '@(...)' == '' instead.
		-->
		<Error Condition="'@(_EndpointsGeneratorAnalyzer)' == ''"
		       Text="PackEndpointsGenerator resolved no analyzer assembly from MintPlayer.AspNetCore.Endpoints.Generator. Packing would produce a nupkg with an empty analyzers/ folder, which restores cleanly and generates nothing." />
		<Error Condition="!Exists('%(_EndpointsGeneratorAnalyzer.FullPath)')"
		       Text="PackEndpointsGenerator resolved '%(_EndpointsGeneratorAnalyzer.FullPath)' but that file does not exist. Packing would produce a nupkg with no analyzer in it and no error." />

		<!--
		  The folder comes from the generator project, which owns $(EndpointsAnalyzerPackPath), so the
		  two packages cannot drift into different analyzer folders. A value passed on the command line
		  is a global property and reaches both projects alike.
		-->
		<MSBuild Condition="'$(EndpointsAnalyzerPackPath)' == ''"
		         Projects="..\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj"
		         Targets="GetEndpointsAnalyzerPackPath"
		         Properties="Configuration=$(Configuration)"
		         RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" PropertyName="EndpointsAnalyzerPackPath" />
		</MSBuild>
		<Error Condition="'$(EndpointsAnalyzerPackPath)' == ''"
		       Text="PackEndpointsGenerator could not resolve EndpointsAnalyzerPackPath from MintPlayer.AspNetCore.Endpoints.Generator. Packing without it would place the analyzer at the package root, where Roslyn never loads it." />

		<!--
		  The code-fix assembly (M11), from the generator project, which owns the list and guards that it
		  resolves to a file that exists. It goes into the same folder as the generator.
		-->
		<MSBuild Projects="..\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj"
		         Targets="GetEndpointsCodeFixAssembly"
		         Properties="Configuration=$(Configuration)"
		         RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" ItemName="_EndpointsCodeFixAnalyzer" />
		</MSBuild>

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_EndpointsGeneratorAnalyzer)" PackagePath="$(EndpointsAnalyzerPackPath)" />
			<TfmSpecificPackageFile Include="@(_EndpointsCodeFixAnalyzer)" PackagePath="$(EndpointsAnalyzerPackPath)" />
		</ItemGroup>

		<ItemGroup>
			<_EndpointsCodeFixPackFile Include="@(TfmSpecificPackageFile)" Condition="'%(Filename)%(Extension)' == 'MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll'" />
			<_MisplacedEndpointsCodeFixPackFile Include="@(_EndpointsCodeFixPackFile)" Condition="'%(PackagePath)' != '$(EndpointsAnalyzerPackPath)'" />
		</ItemGroup>
		<Error Condition="'@(_EndpointsCodeFixPackFile)' == ''"
		       Text="MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll is not among the files being packed. The package would ship without its code fixes." />
		<Error Condition="'@(_MisplacedEndpointsCodeFixPackFile)' != ''"
		       Text="MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll would be packed into '%(_MisplacedEndpointsCodeFixPackFile.PackagePath)' instead of $(EndpointsAnalyzerPackPath), beside the generator." />
	</Target>

</Project>
