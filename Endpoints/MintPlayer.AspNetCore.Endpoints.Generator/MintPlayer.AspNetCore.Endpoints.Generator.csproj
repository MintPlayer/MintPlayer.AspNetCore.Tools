<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<NoWarn>RS2008</NoWarn>

		<IsPackable>true</IsPackable>
		<PackageId>MintPlayer.AspNetCore.Endpoints.Generator</PackageId>
		<Version>11.2.0-rc.0</Version>
		<IncludeSymbols>false</IncludeSymbols>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<Description>Source generator for MintPlayer.AspNetCore.Endpoints - generates endpoint mapping extension methods and partial class base declarations.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageTags>ASP.NET Core, Endpoints, Source Generator</PackageTags>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.AspNetCore.Tools/Endpoints/MintPlayer.AspNetCore.Endpoints.Generator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.AspNetCore.Tools</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Product>MintPlayer.AspNetCore.Endpoints</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
	</PropertyGroup>

	<!-- Include XML markups in the nupkg -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.SourceGenerators.Tools" Version="12.0.1" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="MintPlayer.ValueComparerGenerator" Version="12.0.1" PrivateAssets="all" />
		<PackageReference Include="MintPlayer.ValueComparerGenerator.Attributes" Version="12.0.1" PrivateAssets="all" GeneratePathProperty="true" />
	</ItemGroup>

	<!--
	The typed client's URL builder is the runtime library's own EndpointTemplateBinder.cs, embedded as
	text and emitted into client projects (EndpointClientUrl.g.cs). One source file, so a client URL
	and an EndpointRoute link cannot drift apart; the runtime's LinkGenerator battery pins both. A
	client cannot reference the runtime library instead: it is a Web SDK package (NETSDK1082 on
	browser-wasm, PRD R7.4).
	-->
	<ItemGroup>
		<EmbeddedResource Include="..\MintPlayer.AspNetCore.Endpoints\EndpointTemplateBinder.cs"
		                  LogicalName="MintPlayer.AspNetCore.Endpoints.Generator.EndpointTemplateBinder.cs"
		                  Link="Embedded\EndpointTemplateBinder.cs" />
	</ItemGroup>

	<!--
	build\*.props makes GenerateEndpointsClient visible to the compiler; build\*.targets provides
	EndpointsServerReference, the metadata-only server reference a typed client needs (M9). A client
	references this package, not MintPlayer.AspNetCore.Endpoints, because this one carries no
	FrameworkReference.
	-->
	<ItemGroup>
		<None Include="build\MintPlayer.AspNetCore.Endpoints.Generator.props" Pack="true" PackagePath="build\" />
		<None Include="build\MintPlayer.AspNetCore.Endpoints.Generator.targets" Pack="true" PackagePath="build\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
	One mechanism packs the analyzer here and in MintPlayer.AspNetCore.Endpoints: GetTargetPath,
	whose TargetPathWithTargetPlatformMoniker output already carries this assembly *and* every
	dependency GetDependencyTargetPaths adds below. The two hard-coded globs this replaces
	disagreed with each other — the sibling project spelled out a literal
	..\Generator\bin\$(Configuration)\netstandard2.0\ path — and only one of them was
	Configuration-conditioned, so a Debug pack shipped without MintPlayer.SourceGenerators.Tools
	and the analyzer then failed to load in the consumer, with nothing wrong at pack time.
	-->
	<PropertyGroup>
		<!--
		The one folder the analyzer ships in, in this package and in MintPlayer.AspNetCore.Endpoints
		(which reads it from here through GetEndpointsAnalyzerPackPath); every pack guard below reads it
		too. It is the versioned roslyn5.9 folder (PRD addendum 2, D25, following MintPlayer.Dotnet.Tools'
		rule): Roslyn 5.9 is the floor, and a host older than that finds no folder it qualifies for and
		skips the generator, instead of loading an assembly that references a newer compiler. The first
		symptom there is a missing Map…Endpoints() (CS1061); the READMEs say so. This supersedes the
		unversioned analyzers/dotnet/cs of commit 7e280e6, chosen so an old SDK would report CS9057.
		-->
		<EndpointsAnalyzerPackPath Condition="'$(EndpointsAnalyzerPackPath)' == ''">analyzers/dotnet/roslyn5.9/cs</EndpointsAnalyzerPackPath>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
		<BeforePack>SuppressToolsAnalyzerCopies;$(BeforePack)</BeforePack>
	</PropertyGroup>

	<!--
	MintPlayer.SourceGenerators.Tools' build/MintPlayer.SourceGenerators.Tools.props and
	MintPlayer.ValueComparerGenerator.Attributes' props add static <None Pack="true"> items with copies
	of this generator, Tools.dll and the Attributes assembly: analyzers/dotnet/roslyn5.9/cs since Tools
	11.0.0 (roslyn4.0/roslyn4.9 up to 10.x), plus a Release-only analyzers/dotnet/cs glob for an
	Attributes project this repository does not have. This package packs those same assemblies itself,
	through TfmSpecificPackageFile (PackAnalyzerAssemblies). So every such item is either
	  - a duplicate: the same path as $(EndpointsAnalyzerPackPath), which would add the same file twice
	    (NU5118) — upstream's roslyn5.9/cs copies are exactly that since D25; or
	  - a second analyzer folder, where the SDK resolves every folder as @(Analyzer), the generator runs
	    more than once, and the consumer gets CS0101/CS0111 in files they never wrote (PRD R6.5a).
	Both kinds are removed here, before pack collects @(None), rather than filtered out of the finished
	package. This package's own payload is untouched.
	-->
	<Target Name="SuppressToolsAnalyzerCopies">
		<ItemGroup>
			<_ToolsAnalyzerCopy Include="@(None)"
			                    Condition="'%(None.Pack)' == 'true' and $([System.String]::Copy('%(None.PackagePath)').Replace('\', '/').TrimStart('/').StartsWith('analyzers/'))" />
			<None Remove="@(_ToolsAnalyzerCopy)" />
		</ItemGroup>
	</Target>

	<!--
	The MPEP001/MPEP014/MPEP019 code fix (M11) is a second assembly in the same analyzer folder. It is
	separate because a CodeFixProvider needs Microsoft.CodeAnalysis.Workspaces, which csc's analyzer
	host does not load: inside the generator assembly it would stop the GENERATOR loading on every
	command-line build. Beside it, csc scans it, finds no generator or analyzer, and moves on; only the
	IDE instantiates it (spike S5).

	ReferenceOutputAssembly="false": the reference only orders the build, so the code fix exists before
	either package reads it. It is not part of this assembly's compile closure, and it is deliberately
	not added to GetTargetPath either, which would hand it to csc as an analyzer in every project here
	that references the generator.
	-->
	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.csproj"
		                  ReferenceOutputAssembly="false"
		                  PrivateAssets="all" />
	</ItemGroup>

	<!--
	Returns the code-fix assembly; both packages call it, so there is one place that knows where the
	code fix comes from and one pair of guards on it.

	Two existence tests, and both are needed. GetTargetPath returns a path without touching the disk,
	so '@(x)' == '' catches a target that returned nothing (a renamed project), and
	!Exists('%(x.FullPath)') catches a path that is returned but not built — what a no-build pack over
	a half-cleaned tree looks like. The second batches over the items and runs zero times on an empty
	list, which is why the first exists.
	-->
	<Target Name="GetEndpointsCodeFixAssembly" Returns="@(_EndpointsCodeFixAssembly)">
		<MSBuild Projects="..\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.csproj"
		         Targets="GetTargetPath"
		         Properties="Configuration=$(Configuration)"
		         RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" ItemName="_EndpointsCodeFixAssembly" />
		</MSBuild>
		<Error Condition="'@(_EndpointsCodeFixAssembly)' == ''"
		       Text="GetTargetPath on MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes returned nothing. Packing would produce a package whose code fixes never appear in the IDE, with no error anywhere." />
		<Error Condition="!Exists('%(_EndpointsCodeFixAssembly.FullPath)')"
		       Text="The code-fix assembly '%(_EndpointsCodeFixAssembly.FullPath)' does not exist. Build before packing; otherwise the package ships without its code fixes and nothing reports it." />
	</Target>

	<Target Name="PackAnalyzerAssemblies" DependsOnTargets="GetTargetPath;GetEndpointsCodeFixAssembly">
		<!--
		A guard, because the failure it catches is silent: if SuppressToolsAnalyzerCopies ever stops
		running (a renamed hook, a props change upstream), the package still packs, still installs, and
		the consumer's first build fails on CS0101 with nothing pointing here. A leftover copy in this
		package's own folder is deduplicated rather than rejected: upstream's roslyn5.9/cs items name the
		very folder this package packs into (PRD addendum 2, D25), and this package's TfmSpecificPackageFile
		already carries the file. A copy in any other analyzer folder is an error.
		-->
		<PropertyGroup>
			<_EndpointsAnalyzerPackPathNormalized>$([System.String]::Copy('$(EndpointsAnalyzerPackPath)').Replace('\', '/').Trim('/'))</_EndpointsAnalyzerPackPathNormalized>
		</PropertyGroup>
		<ItemGroup>
			<_SamePathAnalyzerPackFile Include="@(None)"
			                           Condition="'%(None.Pack)' == 'true' and $([System.String]::Copy('%(None.PackagePath)').Replace('\', '/').Trim('/').Equals('$(_EndpointsAnalyzerPackPathNormalized)'))" />
			<None Remove="@(_SamePathAnalyzerPackFile)" />
			<_StrayAnalyzerPackFile Include="@(None)"
			                        Condition="'%(None.Pack)' == 'true' and $([System.String]::Copy('%(None.PackagePath)').Replace('\', '/').TrimStart('/').StartsWith('analyzers/'))" />
		</ItemGroup>
		<Error Condition="'@(_StrayAnalyzerPackFile)' != ''"
		       Text="'%(_StrayAnalyzerPackFile.Identity)' would be packed into '%(_StrayAnalyzerPackFile.PackagePath)' beside $(EndpointsAnalyzerPackPath). A second analyzer folder makes the generator run more than once in the consumer (CS0101/CS0111)." />

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(TargetPathWithTargetPlatformMoniker)" PackagePath="$(EndpointsAnalyzerPackPath)" />
			<TfmSpecificPackageFile Include="@(_EndpointsCodeFixAssembly)" PackagePath="$(EndpointsAnalyzerPackPath)" />
		</ItemGroup>

		<!-- PRD D14: MintPlayer.ValueComparerGenerator.Attributes.dll must ship, and only in the generator's
		     folder. It arrives through the package's own GetTargetPath contribution, so nothing here adds
		     it; these guards notice when that stops. -->
		<ItemGroup>
			<_ValueComparerAttributesPackFile Include="@(TfmSpecificPackageFile)" Condition="'%(Filename)%(Extension)' == 'MintPlayer.ValueComparerGenerator.Attributes.dll'" />
			<_MisplacedValueComparerAttributesPackFile Include="@(_ValueComparerAttributesPackFile)" Condition="'%(PackagePath)' != '$(EndpointsAnalyzerPackPath)'" />
		</ItemGroup>
		<Error Condition="'@(_ValueComparerAttributesPackFile)' == ''"
		       Text="MintPlayer.ValueComparerGenerator.Attributes.dll is not among the files being packed. The generator's models carry its attributes, so the package would ship an analyzer that references an assembly it does not contain." />
		<Error Condition="'@(_MisplacedValueComparerAttributesPackFile)' != ''"
		       Text="MintPlayer.ValueComparerGenerator.Attributes.dll would be packed into '%(_MisplacedValueComparerAttributesPackFile.PackagePath)' instead of $(EndpointsAnalyzerPackPath), beside the generator." />

		<!-- The code fix must ship, and only in the generator's folder: in any other analyzer folder the
		     IDE would load it from a place the SDK never pairs with the generator. -->
		<ItemGroup>
			<_EndpointsCodeFixPackFile Include="@(TfmSpecificPackageFile)" Condition="'%(Filename)%(Extension)' == 'MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll'" />
			<_MisplacedEndpointsCodeFixPackFile Include="@(_EndpointsCodeFixPackFile)" Condition="'%(PackagePath)' != '$(EndpointsAnalyzerPackPath)'" />
		</ItemGroup>
		<Error Condition="'@(_EndpointsCodeFixPackFile)' == ''"
		       Text="MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll is not among the files being packed. The package would ship without its code fixes." />
		<Error Condition="'@(_MisplacedEndpointsCodeFixPackFile)' != ''"
		       Text="MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.dll would be packed into '%(_MisplacedEndpointsCodeFixPackFile.PackagePath)' instead of $(EndpointsAnalyzerPackPath), beside the generator." />
	</Target>

	<!-- Lets MintPlayer.AspNetCore.Endpoints pack into the same folder without a second literal. -->
	<Target Name="GetEndpointsAnalyzerPackPath" Returns="$(EndpointsAnalyzerPackPath)" />

	<Target Name="GetDependencyTargetPaths">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(PkgMintPlayer_SourceGenerators_Tools)\lib\netstandard2.0\MintPlayer.SourceGenerators.Tools.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

	<!--
	Works around an upstream defect (MintPlayer.Dotnet.Tools, reported with PRD D15).
	MintPlayer.ValueComparerGenerator's build\*.targets adds its Attributes assembly to
	TargetPathWithTargetPlatformMoniker with IncludeRuntimeDependency="true". Every project that
	references this one with a plain ProjectReference (Generator.Tests) then receives the Attributes
	assembly as a runtime dependency twice, and GenerateDepsFile fails with
	MSB4018: The "GenerateDepsFile" task failed unexpectedly ... An item with the same key has already
	been added. The assembly is still packed through GetTargetPath (PRD D14); only the runtime flag is
	cleared, as it is for MintPlayer.SourceGenerators.Tools in GetDependencyTargetPaths above.
	Remove this target once the package's own target sets IncludeRuntimeDependency="false".
	-->
	<Target Name="DemoteValueComparerAttributesRuntimeDependency" AfterTargets="GetDependencyTargetPathsValueComparerGenerator">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Condition="'%(Filename)' == 'MintPlayer.ValueComparerGenerator.Attributes'">
				<IncludeRuntimeDependency>false</IncludeRuntimeDependency>
			</TargetPathWithTargetPlatformMoniker>
		</ItemGroup>
	</Target>

	<!--
	The Attributes assembly must reach the analyzer folder (PRD D14). It arrives through the package's
	own GetTargetPath contribution, which needs the package's path property; the package's props sets
	GeneratePathProperty with an Update that runs too early to reach this project's reference, hence
	the explicit GeneratePathProperty="true" above and this guard on it.
	-->
	<Target Name="CheckValueComparerAttributesPathProperty" BeforeTargets="CoreCompile;GetTargetPath" Condition="'$(DesignTimeBuild)' != 'true'">
		<Error Condition="'$(PkgMintPlayer_ValueComparerGenerator_Attributes)' == ''"
		       Text="PkgMintPlayer_ValueComparerGenerator_Attributes is empty. Keep GeneratePathProperty=&quot;true&quot; on the MintPlayer.ValueComparerGenerator.Attributes PackageReference; without it MintPlayer.ValueComparerGenerator.Attributes.dll is not packed beside the generator." />
	</Target>

	<!--
	Build-time only: suppresses the CS1591 that MintPlayer.ValueComparerGenerator's public
	IncrementalValueProviderAdditionalEx adds to this assembly, and nothing else (PRD D16; see the
	suppressor's remarks for why no lighter mechanism works). ReferenceOutputAssembly="false" and
	PrivateAssets="all": it is an analyzer of this compilation only, never packed or shipped.
	-->
	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.AspNetCore.Endpoints.Generator.BuildSuppressions\MintPlayer.AspNetCore.Endpoints.Generator.BuildSuppressions.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  PrivateAssets="all" />
	</ItemGroup>

</Project>
