<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator fixtures compiled by the driver need HttpContext, IResult,
		     RouteHandlerBuilder and IEndpointRouteBuilder. Basic.Reference.Assemblies ships
		     no ASP.NET Core reference assemblies, so the driver's reference set is built from
		     this test host's own TRUSTED_PLATFORM_ASSEMBLIES instead. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Microsoft.CodeAnalysis.CSharp is deliberately NOT referenced here. The
		     SourceGenerators.Tools package's own build props inject it, and declaring it again
		     produced NU1504 (duplicate PackageReference). Relying on the injected one also
		     guarantees the driver loads the same Roslyn version the generator was compiled
		     against — verified 5.9.0 — which a hand-pinned version could silently drift from. -->

		<!-- The generator references this with PrivateAssets="all", so it does NOT flow
		     transitively. Without an explicit reference the driver throws FileNotFoundException
		     the moment it touches the IncrementalGenerator base class. -->
		<PackageReference Include="MintPlayer.SourceGenerators.Tools" Version="12.1.0" GeneratePathProperty="true" />

		<!-- The code-fix harness (M11). NOT the .XUnit flavour: its newest version, 1.1.2, was built
		     against xunit 2.4.x and every assertion dies with MissingMethodException on this repo's
		     xunit 2.9.3 (spike S5). The plain package's DefaultVerifier has no xunit dependency. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
		<!-- The code-fix project references Workspaces with ExcludeAssets="runtime" so that nothing of it
		     ships; the test host has to supply the real assembly, at the generator's Roslyn (5.9.0). -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />

		<!-- Only so the OpenAPI emission tests can compile EndpointOpenApi.g.cs: the harness keeps
		     these assemblies OUT of the fixture compilation unless a test asks for them, because
		     their mere presence is what switches that file on. Conditioned per TFM like
		     Microsoft.AspNetCore.Mvc.Testing, so net11.0 compiles against Microsoft.OpenApi 3.x. -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.1.26425.128" Condition="'$(TargetFramework)' == 'net11.0'" />
	</ItemGroup>

	<!--
	A PLAIN ProjectReference, deliberately — not OutputItemType="Analyzer".

	Two reasons:

	1. Coverage attribution. Coverlet's collector scans the test host's output directory
	   ROOT and does NOT recurse, so the generator DLL *and its PDB* must land there. A
	   default ProjectReference (ReferenceOutputAssembly=true) copies both, in every
	   configuration, with no custom target. An Analyzer reference is passed to csc as
	   /analyzer: and is never copied to $(OutDir), so coverlet would see nothing.
	   IncludeBuildOutput=false / DevelopmentDependency=true in the generator csproj are
	   pack-time only and do not suppress this copy.

	   If a copy target is ever needed here instead, it MUST be unconditional. Never
	   Condition="'$(Configuration)'=='Debug'" — CI tests Release, so a Debug-only condition
	   silently zeroes generator coverage, and the failure mode gives no error.

	2. The generator is exercised in-process by a CSharpGeneratorDriver, not by csc. An
	   analyzer execution during build is not observed by the test host's profiler, so
	   coverage can ONLY come from tests that call `new EndpointGenerator()` directly.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Endpoints\MintPlayer.AspNetCore.Endpoints.Generator\MintPlayer.AspNetCore.Endpoints.Generator.csproj" />
		<!-- Plain for the same coverage reason as the generator: its DLL and PDB land in the output root. -->
		<ProjectReference Include="..\..\Endpoints\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes\MintPlayer.AspNetCore.Endpoints.Generator.CodeFixes.csproj" />
		<!-- Fixture sources reference these types; the driver also needs them as metadata
		     references. -->
		<ProjectReference Include="..\..\Endpoints\MintPlayer.AspNetCore.Endpoints\MintPlayer.AspNetCore.Endpoints.csproj" />
		<ProjectReference Include="..\..\Endpoints\MintPlayer.AspNetCore.Endpoints.Abstractions\MintPlayer.AspNetCore.Endpoints.Abstractions.csproj" />
	</ItemGroup>

</Project>
